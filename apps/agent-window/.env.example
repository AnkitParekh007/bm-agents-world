# CopilotKit BuiltInAgent model. Provider:model syntax is supported.
AI_MODEL=openai:gpt-5.4-mini

# Set the credential required by the selected model provider.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=

PORT=4000

# Deployment mode controls readiness strictness.
BM_DEPLOYMENT_MODE=development
# BM_PILOT_REQUIRE_JIRA_WRITE=false
# BM_AGENTS_REPO_ROOT=/absolute/path/to/bm-agents-world

# -----------------------------------------------------------------------------
# Phase 7 real QA team pilot
# -----------------------------------------------------------------------------
# Shared pilot validation defaults to PCC, both approved non-production browser
# environments, and two serving replicas. Change these only in an environment
# overlay when onboarding another real project or intentionally resizing.
# BM_PILOT_PROJECT_IDS=PCC
# BM_PILOT_REQUIRED_ENVIRONMENTS=playground,qa
# BM_PILOT_EXPECTED_REPLICAS=2
#
# Remote validation CLI (run through the organization trusted gateway):
# BM_PILOT_BASE_URL=https://bm-agents-world.internal.example
# BM_PILOT_VALIDATION_REQUESTS=12
# BM_PILOT_VALIDATION_BEARER_TOKEN=
# BM_PILOT_VALIDATION_COOKIE=

# -----------------------------------------------------------------------------
# Central policy + approved connector registry
# -----------------------------------------------------------------------------
# Local development can use the deterministic in-process evaluator. Shared pilot
# deployments use OPA and fail closed if OPA cannot return a complete decision.
# BM_POLICY_MODE=local
# BM_POLICY_MODE=opa
# BM_OPA_URL=http://127.0.0.1:8181
# BM_OPA_TIMEOUT_MS=1500
# BM_CONNECTOR_REGISTRY_PATH=/absolute/path/to/config/approved-connectors.yaml
#
# Only capability/tool mappings present in the approved connector registry can
# be admitted by the centralized evaluator. Credentials remain server-side.

# -----------------------------------------------------------------------------
# Runtime persistence
# -----------------------------------------------------------------------------
BM_PERSISTENCE_MODE=sqlite-filesystem
# BM_STATE_DB_PATH=/secure/runtime/data/state/qa-pilot.sqlite
# BM_ARTIFACT_ROOT=/secure/runtime/data
#
# Shared team pilot / horizontal scaling:
# BM_PERSISTENCE_MODE=postgres-supabase
# BM_POSTGRES_URL=postgresql://...
# BM_POSTGRES_POOL_MAX=10
# BM_POSTGRES_STATEMENT_TIMEOUT_MS=15000
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_...
# BM_SUPABASE_ARTIFACT_BUCKET=bm-agents-world-evidence
# Apply deploy/supabase/shared-runtime-schema.sql and create the bucket as PRIVATE.

# -----------------------------------------------------------------------------
# Request identity
# -----------------------------------------------------------------------------
BM_IDENTITY_MODE=local-dev
# BM_LOCAL_USER_ID=local-dev-user
# BM_LOCAL_TENANT_ID=local-dev
# BM_LOCAL_PROJECT_IDS=PCC,SOP,DataBridge
# BM_LOCAL_ALLOW_SELF_APPROVAL=true
# For a shared deployment use trusted-headers behind an authenticated gateway.
# BM_IDENTITY_MODE=trusted-headers

# Optional test-catalog override.
# QA_PROJECT_TEST_CATALOG=/absolute/path/to/qa-project-tests.yaml

COPILOTKIT_TELEMETRY_DISABLED=true

# -----------------------------------------------------------------------------
# Model usage + OpenTelemetry
# -----------------------------------------------------------------------------
# BM_MODEL_INPUT_USD_PER_1M_TOKENS=
# BM_MODEL_OUTPUT_USD_PER_1M_TOKENS=
# BM_OTEL_ENABLED=false
# OTEL_SERVICE_NAME=bm-agents-world-agent-window
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://otel-collector.observability.svc:4318/v1/traces
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer%20...
# OTEL_SDK_DISABLED=false

# -----------------------------------------------------------------------------
# QA Jira Cloud read + governed defect adapter
# -----------------------------------------------------------------------------
# QA_JIRA_BASE_URL=https://your-company.atlassian.net
# QA_JIRA_EMAIL=qa-automation@your-company.com
# QA_JIRA_API_TOKEN=
# QA_JIRA_BEARER_TOKEN=
# QA_JIRA_ACCEPTANCE_CRITERIA_FIELD=
# QA_JIRA_WRITE_ENABLED=false
# QA_JIRA_BUG_ISSUE_TYPE=Bug
# QA_JIRA_BUG_LABELS=bm-agent,qa-automation
# QA_PCC_JIRA_PROJECT_KEY=PCC
# QA_SOP_JIRA_PROJECT_KEY=SOP
# QA_DATABRIDGE_JIRA_PROJECT_KEY=DATABRIDGE

# -----------------------------------------------------------------------------
# QA Bitbucket Cloud read adapter
# -----------------------------------------------------------------------------
# QA_BITBUCKET_ACCESS_TOKEN=
# QA_BITBUCKET_BASE_URL=https://api.bitbucket.org/2.0
# QA_BITBUCKET_WORKSPACE=your-workspace
# QA_PCC_BITBUCKET_REPOS=frontend:pcc-ui,backend:pcc-api
# QA_SOP_BITBUCKET_REPOS=frontend:sop-ui,backend:sop-api
# QA_DATABRIDGE_BITBUCKET_REPOS=frontend:databridge-ui,backend:databridge-api

# -----------------------------------------------------------------------------
# QA Playwright worker
# -----------------------------------------------------------------------------
# QA_PLAYWRIGHT_ENABLED=true
# QA_PLAYWRIGHT_TIMEOUT_MS=45000
# QA_PCC_PLAYWRIGHT_PLAYGROUND_URL=https://pcc-playground.example.internal
# QA_PCC_PLAYWRIGHT_QA_URL=https://pcc-qa.example.internal
# QA_SOP_PLAYWRIGHT_PLAYGROUND_URL=https://sop-playground.example.internal
# QA_SOP_PLAYWRIGHT_QA_URL=https://sop-qa.example.internal
# QA_DATABRIDGE_PLAYWRIGHT_PLAYGROUND_URL=https://databridge-playground.example.internal
# QA_DATABRIDGE_PLAYWRIGHT_QA_URL=https://databridge-qa.example.internal
# QA_PCC_PLAYWRIGHT_STORAGE_STATE=/secure/runtime/playwright-auth/pcc-user.json
# QA_SOP_PLAYWRIGHT_STORAGE_STATE=/secure/runtime/playwright-auth/sop-user.json
# QA_DATABRIDGE_PLAYWRIGHT_STORAGE_STATE=/secure/runtime/playwright-auth/databridge-user.json

# -----------------------------------------------------------------------------
# QA Teams status adapter
# -----------------------------------------------------------------------------
# Server-side Microsoft Teams Incoming Webhook. Only Teams / Power Automate hosts
# are accepted. Unset means qa.teams.status.post runs as an honest mock.
# QA_TEAMS_WEBHOOK_URL=https://your-tenant.webhook.office.com/webhookb2/...

# -----------------------------------------------------------------------------
# QA database validation adapter
# -----------------------------------------------------------------------------
# Read-only connection plus an operator-curated allowlist of named validations.
# The model supplies only a validationId, never SQL. Both unset means
# qa.database.validation.read runs as an honest mock. The capability is hidden
# from the agent unless the opt-in flag is enabled.
# QA_DATABASE_VALIDATION_ENABLED=false
# QA_DATABASE_URL=postgresql://readonly@db.internal/qa
# QA_DATABASE_VALIDATIONS_PATH=/absolute/path/to/qa-database-validations.yaml

# -----------------------------------------------------------------------------
# QA API contract adapter
# -----------------------------------------------------------------------------
# Operator-curated allowlist of read-only API contract checks. The model supplies
# only a contractId, never a URL. Unset means qa.api.contract.test runs as a mock.
# QA_API_CONTRACTS_PATH=/absolute/path/to/qa-api-contracts.yaml
