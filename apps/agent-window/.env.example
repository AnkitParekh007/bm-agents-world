# CopilotKit BuiltInAgent model. Provider:model syntax is supported.
AI_MODEL=openai:gpt-5.4-mini

# Set the credential required by the selected model provider.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=

PORT=4000

# Optional when running the workspace from an unusual working directory.
# BM_AGENTS_REPO_ROOT=/absolute/path/to/bm-agents-world

# Recommended for internal development if you do not want anonymous package telemetry.
COPILOTKIT_TELEMETRY_DISABLED=true

# -----------------------------------------------------------------------------
# QA Jira Cloud read adapter
# -----------------------------------------------------------------------------
# Live mode is enabled only when QA_JIRA_BASE_URL plus a supported server-side
# credential are configured. Otherwise qa.jira.story.read keeps using mock mode.
# Never expose these values to browser code or agent prompts.
# QA_JIRA_BASE_URL=https://your-company.atlassian.net
# QA_JIRA_EMAIL=qa-automation@your-company.com
# QA_JIRA_API_TOKEN=
#
# Alternative bearer credential for a compatible Jira endpoint/auth setup.
# QA_JIRA_BEARER_TOKEN=
#
# Optional custom field id, for example customfield_12345.
# QA_JIRA_ACCEPTANCE_CRITERIA_FIELD=

# -----------------------------------------------------------------------------
# QA Bitbucket Cloud read adapter
# -----------------------------------------------------------------------------
# A read-scoped access token is required for live mode.
# QA_BITBUCKET_ACCESS_TOKEN=
# QA_BITBUCKET_BASE_URL=https://api.bitbucket.org/2.0
# QA_BITBUCKET_WORKSPACE=your-workspace
#
# Project repository overrides. Format:
# label:repo-slug,label:workspace/repo-slug
# If these are omitted, the adapter also tries to infer Bitbucket Cloud repos
# from packs/qa-agent-pack/config/project-registry.yaml repository URLs.
# QA_PCC_BITBUCKET_REPOS=frontend:pcc-ui,backend:pcc-api
# QA_SOP_BITBUCKET_REPOS=frontend:sop-ui,backend:sop-api
# QA_DATABRIDGE_BITBUCKET_REPOS=frontend:databridge-ui,backend:databridge-api
