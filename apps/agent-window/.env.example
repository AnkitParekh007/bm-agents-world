# CopilotKit BuiltInAgent model. Provider:model syntax is supported.
AI_MODEL=openai:gpt-5.4-mini

# Set the credential required by the selected model provider.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=

PORT=4000

# Deployment mode controls readiness strictness. `development` keeps local setup
# permissive; `pilot` makes /readyz fail until trusted identity, persistent
# storage, model credentials, Jira/Bitbucket reads, and Playwright are live.
BM_DEPLOYMENT_MODE=development
# BM_PILOT_REQUIRE_JIRA_WRITE=false

# Optional when running the workspace from an unusual working directory.
# BM_AGENTS_REPO_ROOT=/absolute/path/to/bm-agents-world

# Optional runtime evidence root. For a shared pilot, set this to a persistent,
# writable absolute directory. Artifacts are stored below this root.
# BM_ARTIFACT_ROOT=/secure/runtime/data

# Persistent QA run/action/approval/audit database. Defaults to
# .bm-agents-runtime/state/qa-pilot.sqlite below the workspace process directory.
# Shared pilot mode requires an absolute writable path on persistent storage.
# Requires Node >= 22.13 because the pilot uses node:sqlite.
# BM_STATE_DB_PATH=/secure/runtime/data/state/qa-pilot.sqlite

# -----------------------------------------------------------------------------
# Request identity
# -----------------------------------------------------------------------------
# local-dev is the safe standalone default. It is intended only for local pilot
# work and can allow the local requester to approve its own action.
BM_IDENTITY_MODE=local-dev
# BM_LOCAL_USER_ID=local-dev-user
# BM_LOCAL_TENANT_ID=local-dev
# BM_LOCAL_PROJECT_IDS=PCC,SOP,DataBridge
# BM_LOCAL_ALLOW_SELF_APPROVAL=true
#
# For a shared deployment, place the app behind an authenticated gateway/SSO
# layer that strips user-supplied identity headers and injects trusted headers:
#   x-user-id
#   x-tenant-id
#   x-project-ids  (comma separated; or x-project-id for one project)
# Then enable:
# BM_IDENTITY_MODE=trusted-headers
#
# In trusted-headers mode missing identity fails with HTTP 401, tenant/project
# scope is enforced on runs/actions/artifacts/audit, and requester self-approval
# is denied for protected actions.
#
# Container/Kubernetes probes do not require identity and expose no user data:
#   GET /healthz  -> process liveness
#   GET /readyz   -> deployment readiness contract

# Optional test-catalog override. Defaults to apps/agent-window/config/qa-project-tests.yaml.
# QA_PROJECT_TEST_CATALOG=/absolute/path/to/qa-project-tests.yaml

# CopilotKit's own anonymous product telemetry stays disabled for this incubation
# project. BM telemetry below is separate, server-side operational telemetry.
COPILOTKIT_TELEMETRY_DISABLED=true

# -----------------------------------------------------------------------------
# Model usage + OpenTelemetry
# -----------------------------------------------------------------------------
# Token counts are persisted only when numeric provider/AG-UI usage metadata is
# actually present. Missing metadata remains `unavailable`; it is never treated
# as zero usage.
#
# Cost is an explicit configured estimate. Validate the selected model's rates
# outside this repository; no provider prices are hard-coded here.
# BM_MODEL_INPUT_USD_PER_1M_TOKENS=
# BM_MODEL_OUTPUT_USD_PER_1M_TOKENS=
#
# OpenTelemetry trace export is opt-in. Standard OTLP exporter environment
# variables are honored. Do not include secrets or prompts in resource attrs.
# BM_OTEL_ENABLED=false
# OTEL_SERVICE_NAME=bm-agents-world-agent-window
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://otel-collector.observability.svc:4318/v1/traces
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer%20...
# OTEL_SDK_DISABLED=false

# -----------------------------------------------------------------------------
# QA Jira Cloud read + governed defect adapter
# -----------------------------------------------------------------------------
# QA_JIRA_BASE_URL=https://your-company.atlassian.net
# QA_JIRA_EMAIL=qa-automation@your-company.com
# QA_JIRA_API_TOKEN=
# QA_JIRA_BEARER_TOKEN=
# QA_JIRA_ACCEPTANCE_CRITERIA_FIELD=
#
# Real Jira creation is an additional explicit opt-in. The same server-side
# credential must have Create Issues permission for the configured projects.
# The LLM never receives these credentials and qa.jira.bug.create still requires
# payload-bound L3 human approval before the adapter can POST to Jira.
# QA_JIRA_WRITE_ENABLED=false
# QA_JIRA_BUG_ISSUE_TYPE=Bug
# QA_JIRA_BUG_LABELS=bm-agent,qa-automation
# QA_PCC_JIRA_PROJECT_KEY=PCC
# QA_SOP_JIRA_PROJECT_KEY=SOP
# QA_DATABRIDGE_JIRA_PROJECT_KEY=DATABRIDGE

# -----------------------------------------------------------------------------
# QA Bitbucket Cloud read adapter
# -----------------------------------------------------------------------------
# QA_BITBUCKET_ACCESS_TOKEN=
# QA_BITBUCKET_BASE_URL=https://api.bitbucket.org/2.0
# QA_BITBUCKET_WORKSPACE=your-workspace
# QA_PCC_BITBUCKET_REPOS=frontend:pcc-ui,backend:pcc-api
# QA_SOP_BITBUCKET_REPOS=frontend:sop-ui,backend:sop-api
# QA_DATABRIDGE_BITBUCKET_REPOS=frontend:databridge-ui,backend:databridge-api

# -----------------------------------------------------------------------------
# QA Playwright worker
# -----------------------------------------------------------------------------
# Browser execution is opt-in. Only playground and qa are executable.
# The agent cannot provide target URLs, selectors, scripts, credentials, or test files.
#
# Install the pinned Chromium build once with:
# npm run playwright:install --workspace @bm-agents-world/agent-window
#
# QA_PLAYWRIGHT_ENABLED=true
# QA_PLAYWRIGHT_TIMEOUT_MS=45000
# QA_PCC_PLAYWRIGHT_PLAYGROUND_URL=https://pcc-playground.example.internal
# QA_PCC_PLAYWRIGHT_QA_URL=https://pcc-qa.example.internal
# QA_SOP_PLAYWRIGHT_PLAYGROUND_URL=https://sop-playground.example.internal
# QA_SOP_PLAYWRIGHT_QA_URL=https://sop-qa.example.internal
# QA_DATABRIDGE_PLAYWRIGHT_PLAYGROUND_URL=https://databridge-playground.example.internal
# QA_DATABRIDGE_PLAYWRIGHT_QA_URL=https://databridge-qa.example.internal
#
# Optional authenticated browser state. These values are SERVER-SIDE FILE PATHS,
# never cookie JSON or credentials themselves. The referenced files can contain
# sensitive cookies/local storage and must never be committed.
# QA_PCC_PLAYWRIGHT_STORAGE_STATE=/secure/runtime/playwright-auth/pcc-user.json
# QA_SOP_PLAYWRIGHT_STORAGE_STATE=/secure/runtime/playwright-auth/sop-user.json
# QA_DATABRIDGE_PLAYWRIGHT_STORAGE_STATE=/secure/runtime/playwright-auth/databridge-user.json