{
  "name": "@bm-agents-world/agent-window",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "dev:client": "vite --host 0.0.0.0",
    "dev:all": "concurrently -k -n api,ui -c auto \"npm:dev\" \"npm:dev:client\"",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/server/platform/capability-broker.test.ts src/server/platform/async-capability-broker.test.ts src/server/platform/capability-store.test.ts src/server/platform/request-identity.test.ts src/server/platform/deployment-readiness.test.ts src/server/platform/deployment-contract.test.ts src/server/platform/qa-pilot-observability.test.ts src/server/platform/agent-telemetry.test.ts src/server/platform/pilot-telemetry-view.test.ts src/server/platform/shared-persistence-contract.test.ts src/server/platform/supabase-artifact-store.test.ts src/server/qa/read-adapters.test.ts src/server/qa/qa-project-tests.test.ts src/server/qa/playwright-worker-adapter.test.ts src/server/qa/jira-defect-adapter.test.ts",
    "playwright:install": "playwright install --with-deps chromium",
    "start": "tsx src/server/index.ts"
  },
  "dependencies": {
    "@ag-ui/client": "0.0.57",
    "@copilotkit/react-core": "1.63.2",
    "@copilotkit/runtime": "1.63.2",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.221.0",
    "@opentelemetry/sdk-node": "0.221.0",
    "@supabase/supabase-js": "2.110.9",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "pg": "8.22.0",
    "playwright": "1.62.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "rxjs": "7.8.1",
    "yaml": "^2.8.1",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.17.1",
    "@types/pg": "8.20.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.1"
  }
}
