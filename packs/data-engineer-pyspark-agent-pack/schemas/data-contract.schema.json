{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Data Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "version",
    "owner",
    "schema",
    "compatibility",
    "service_levels"
  ],
  "properties": {
    "contract_id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "schema": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "type"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "nullable": {
            "type": "boolean"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "compatibility": {
      "type": "string"
    },
    "service_levels": {
      "type": "object"
    },
    "quality_rules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "consumers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
