{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pipeline Design",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "mode",
    "inputs",
    "outputs",
    "transformations",
    "quality",
    "operations"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "batch",
        "streaming",
        "hybrid"
      ]
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "transformations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "quality": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "operations": {
      "type": "object"
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
