{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Production Data Action Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project",
    "environment",
    "action",
    "targets",
    "payload_hash",
    "approval",
    "stop_conditions",
    "verification"
  ],
  "properties": {
    "project": {
      "type": "string"
    },
    "environment": {
      "const": "production"
    },
    "action": {
      "type": "string"
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "payload_hash": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "approval": {
      "type": "object",
      "required": [
        "status",
        "actor",
        "not_expired"
      ],
      "properties": {
        "status": {
          "const": "approved"
        },
        "actor": {
          "type": "string"
        },
        "not_expired": {
          "const": true
        }
      }
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "raw_secrets_present": {
      "const": false
    }
  }
}
