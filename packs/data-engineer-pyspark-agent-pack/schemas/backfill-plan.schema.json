{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Backfill Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "datasets",
    "partitions",
    "execution_order",
    "controls",
    "stop_conditions",
    "verification",
    "approval_required"
  ],
  "properties": {
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "partitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "execution_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "rollback": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approval_required": {
      "const": true
    }
  }
}
