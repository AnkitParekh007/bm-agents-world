{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MLOps Platform Context",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "string",
      "minLength": 1
    },
    "tenant_or_workspace": {
      "type": "string",
      "minLength": 1
    },
    "cluster_or_platform": {
      "type": "string",
      "minLength": 1
    },
    "source_revision": {
      "type": "string",
      "minLength": 1
    },
    "data_classification": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ]
    },
    "allowed_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "platform_versions": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "required": [
    "project_id",
    "environment",
    "tenant_or_workspace",
    "data_classification",
    "allowed_actions"
  ]
}