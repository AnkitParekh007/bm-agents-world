{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Model Promotion Request",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "string",
      "minLength": 1
    },
    "candidate_digest": {
      "type": "string",
      "minLength": 1
    },
    "container_digest": {
      "type": "string",
      "minLength": 1
    },
    "configuration_digest": {
      "type": "string",
      "minLength": 1
    },
    "target_endpoint": {
      "type": "string",
      "minLength": 1
    },
    "payload_hash": {
      "type": "string",
      "minLength": 1
    },
    "evaluation_report_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "security_report_ref": {
      "type": "string",
      "minLength": 1
    },
    "governance_report_ref": {
      "type": "string",
      "minLength": 1
    },
    "rollback_candidate": {
      "type": "string",
      "minLength": 1
    },
    "stop_conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "approver": {
      "type": "string",
      "minLength": 1
    },
    "expires_at": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "project_id",
    "environment",
    "candidate_digest",
    "target_endpoint",
    "payload_hash",
    "evaluation_report_refs",
    "rollback_candidate",
    "stop_conditions",
    "approver",
    "expires_at"
  ]
}