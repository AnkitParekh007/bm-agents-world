{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Serving Readiness Report",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "candidate_digest": {
      "type": "string",
      "minLength": 1
    },
    "runtime": {
      "type": "string",
      "minLength": 1
    },
    "slo_ref": {
      "type": "string",
      "minLength": 1
    },
    "capacity_plan_ref": {
      "type": "string",
      "minLength": 1
    },
    "health_checks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "autoscaling": {
      "type": "string",
      "minLength": 1
    },
    "fallback": {
      "type": "string",
      "minLength": 1
    },
    "observability": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "security_controls": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "ready",
        "conditional",
        "not_ready"
      ]
    }
  },
  "required": [
    "candidate_digest",
    "runtime",
    "health_checks",
    "status"
  ]
}