{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Platform Incident Report",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "incident_id": {
      "type": "string",
      "minLength": 1
    },
    "severity": {
      "type": "string",
      "minLength": 1
    },
    "started_at": {
      "type": "string",
      "minLength": 1
    },
    "affected_projects": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "affected_services": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "candidate_or_release_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "mitigations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "recovery_status": {
      "type": "string",
      "minLength": 1
    },
    "follow_up_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "incident_id",
    "severity",
    "started_at",
    "affected_services",
    "recovery_status"
  ]
}