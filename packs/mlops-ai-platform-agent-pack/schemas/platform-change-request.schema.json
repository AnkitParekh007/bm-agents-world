{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Platform Change Request",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "string",
      "minLength": 1
    },
    "change_type": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "source_revision": {
      "type": "string",
      "minLength": 1
    },
    "payload_hash": {
      "type": "string",
      "minLength": 1
    },
    "plan_summary": {
      "type": "string",
      "minLength": 1
    },
    "blast_radius": {
      "type": "string",
      "minLength": 1
    },
    "stop_conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rollback": {
      "type": "string",
      "minLength": 1
    },
    "approval": {
      "type": "string",
      "minLength": 1
    },
    "expires_at": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "project_id",
    "environment",
    "change_type",
    "target",
    "payload_hash",
    "plan_summary",
    "stop_conditions",
    "rollback",
    "approval",
    "expires_at"
  ]
}