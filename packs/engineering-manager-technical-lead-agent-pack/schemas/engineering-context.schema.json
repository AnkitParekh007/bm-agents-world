{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bm-agent-foundry.local/schemas/engineering-context.schema.json",
  "title": "Engineering Context",
  "type": "object",
  "required": [
    "projectId",
    "operatingProfile",
    "workItems",
    "teams",
    "repositories",
    "environments",
    "decisionRights",
    "evidenceReferences"
  ],
  "properties": {
    "projectId": {
      "type": "string"
    },
    "operatingProfile": {
      "enum": [
        "engineering-manager",
        "technical-lead",
        "hybrid"
      ]
    },
    "workItems": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "teams": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "repositories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "services": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "environments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decisionRights": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dataClassifications": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidenceReferences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}