{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bm-agent-foundry.local/schemas/technical-decision-record.schema.json",
  "title": "Technical Decision Record",
  "type": "object",
  "required": [
    "context",
    "options",
    "recommendation",
    "tradeoffs",
    "risks",
    "decisionOwner",
    "status",
    "evidenceReferences"
  ],
  "properties": {
    "context": {
      "type": "string"
    },
    "options": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object"
      }
    },
    "recommendation": {
      "type": "string"
    },
    "tradeoffs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "decisionOwner": {
      "type": "string"
    },
    "reviewers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "draft",
        "in-review",
        "accepted",
        "rejected",
        "superseded"
      ]
    },
    "evidenceReferences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}