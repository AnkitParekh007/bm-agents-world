{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bm-agent-foundry.local/schemas/engineering-delivery-plan.schema.json",
  "title": "Engineering Delivery Plan",
  "type": "object",
  "required": [
    "objective",
    "workstreams",
    "milestones",
    "capacityScenarios",
    "dependencies",
    "risks",
    "forecast",
    "decisionRequests"
  ],
  "properties": {
    "objective": {
      "type": "string"
    },
    "workstreams": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "capacityScenarios": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "forecast": {
      "type": "object",
      "required": [
        "range",
        "confidence"
      ],
      "properties": {
        "range": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "decisionRequests": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": false
}