{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bm-agent-foundry.local/schemas/team-health-assessment.schema.json",
  "title": "Team Health Assessment",
  "type": "object",
  "required": [
    "purpose",
    "aggregationLevel",
    "signals",
    "findings",
    "actions",
    "privacyControls",
    "humanOwner"
  ],
  "properties": {
    "purpose": {
      "type": "string"
    },
    "aggregationLevel": {
      "enum": [
        "team",
        "group",
        "organization"
      ]
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "privacyControls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "prohibitedInferences": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "humanOwner": {
      "type": "string"
    },
    "evidenceReferences": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}