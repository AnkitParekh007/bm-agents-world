{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ux-agent/design-brief.schema.json",
  "title": "Design Brief",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "problem",
    "users",
    "outcomes",
    "scope",
    "constraints",
    "success_measures"
  ],
  "properties": {
    "problem": {
      "type": "string",
      "minLength": 1
    },
    "users": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "jobs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "outcomes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "scope": {
      "type": "object"
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "success_measures": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
