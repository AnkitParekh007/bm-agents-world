{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ux-agent/work-context.schema.json",
  "title": "Work Context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "project",
    "request",
    "known_facts",
    "assumptions",
    "evidence"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "request": {
      "type": "string",
      "minLength": 1
    },
    "jira_item": {
      "type": [
        "string",
        "null"
      ]
    },
    "figma_file": {
      "type": [
        "string",
        "null"
      ]
    },
    "known_facts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sensitivity": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ]
    }
  }
}
