{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ux-agent/prototype-specification.schema.json",
  "title": "Prototype Specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "flows",
    "screens",
    "states",
    "interactions",
    "responsive",
    "accessibility"
  ],
  "properties": {
    "flows": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "screens": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "states": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "interactions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "data_requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "responsive": {
      "type": "object"
    },
    "accessibility": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "test_instrumentation": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "figma_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
