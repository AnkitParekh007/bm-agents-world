{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-ml/model-card.schema.json",
  "title": "Model Card",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "model_id": {
      "type": "string",
      "minLength": 1
    },
    "intended_use": {
      "type": "string",
      "minLength": 1
    },
    "prohibited_uses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "training_data_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evaluation_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risk_controls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "human_oversight": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifact_digest": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "model_id",
    "intended_use",
    "evaluation_refs",
    "limitations",
    "artifact_digest"
  ]
}
