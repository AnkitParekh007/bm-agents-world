{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-ml/production-model-action-request.schema.json",
  "title": "Production Model Action Request",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "const": "production"
    },
    "action": {
      "type": "string",
      "enum": [
        "promote-model",
        "change-traffic",
        "deploy-endpoint",
        "rollback-model",
        "update-approved-index",
        "other-approved-action"
      ]
    },
    "candidate_digest": {
      "type": "string",
      "minLength": 1
    },
    "payload_hash": {
      "type": "string",
      "minLength": 1
    },
    "expected_outcome": {
      "type": "string",
      "minLength": 1
    },
    "stop_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rollback": {
      "type": "string",
      "minLength": 1
    },
    "approver": {
      "type": "string",
      "minLength": 1
    },
    "expires_at": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "request_id",
    "project_id",
    "environment",
    "action",
    "candidate_digest",
    "payload_hash",
    "expected_outcome",
    "stop_conditions",
    "rollback",
    "approver",
    "expires_at"
  ]
}
