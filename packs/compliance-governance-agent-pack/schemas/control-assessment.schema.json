{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.internal/schemas/control-assessment.schema.json",
  "title": "Control Assessment",
  "type": "object",
  "required": [
    "control_id",
    "scope",
    "status",
    "evidence"
  ],
  "properties": {
    "control_id": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assessor_confidence": {
      "type": "number"
    }
  },
  "additionalProperties": false
}
