{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.internal/schemas/compliance-context.schema.json",
  "title": "Compliance Context",
  "type": "object",
  "required": [
    "project",
    "purpose",
    "frameworks",
    "environment",
    "requester"
  ],
  "properties": {
    "project": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "frameworks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "environment": {
      "type": "string"
    },
    "requester": {
      "type": "string"
    },
    "expires_at": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
