{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.internal/schemas/audit-finding.schema.json",
  "title": "Audit Finding",
  "type": "object",
  "required": [
    "finding_id",
    "criteria",
    "condition",
    "evidence",
    "severity"
  ],
  "properties": {
    "finding_id": {
      "type": "string"
    },
    "criteria": {
      "type": "string"
    },
    "condition": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "severity": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "due_date": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
