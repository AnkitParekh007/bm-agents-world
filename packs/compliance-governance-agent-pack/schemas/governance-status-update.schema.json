{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.internal/schemas/governance-status-update.schema.json",
  "title": "Governance Status Update",
  "type": "object",
  "required": [
    "scope",
    "summary",
    "risks",
    "findings",
    "decisions_needed"
  ],
  "properties": {
    "scope": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decisions_needed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
