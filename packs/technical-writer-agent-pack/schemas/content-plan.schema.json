{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Content Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plan_id",
    "scope",
    "content_types",
    "owners",
    "milestones",
    "reviewers",
    "publication_targets"
  ],
  "properties": {
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "content_types": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "owners": {
      "type": "object"
    },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "reviewers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "publication_targets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "success_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
