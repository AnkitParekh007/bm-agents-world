{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Documentation Context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "project",
    "audiences",
    "sources",
    "versions",
    "publication_target"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "audiences": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "versions": {
      "type": "object"
    },
    "publication_target": {
      "type": "string",
      "minLength": 1
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
