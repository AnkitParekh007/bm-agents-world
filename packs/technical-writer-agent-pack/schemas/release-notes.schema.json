{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Release Notes",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "release_id",
    "candidate_hash",
    "audiences",
    "changes",
    "known_issues"
  ],
  "properties": {
    "release_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_hash": {
      "type": "string",
      "minLength": 1
    },
    "audiences": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "known_issues": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "upgrade_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "deprecations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
