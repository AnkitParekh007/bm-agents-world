{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Documentation Change",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "change_id",
    "files",
    "source_revision",
    "product_version",
    "claims",
    "validation"
  ],
  "properties": {
    "change_id": {
      "type": "string",
      "minLength": 1
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_revision": {
      "type": "string",
      "minLength": 1
    },
    "product_version": {
      "type": "string",
      "minLength": 1
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "validation": {
      "type": "object"
    },
    "payload_hash": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
