{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Frontend Implementation Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runId",
    "baseCommit",
    "risk",
    "steps",
    "validation"
  ],
  "properties": {
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "baseCommit": {
      "type": "string",
      "minLength": 1
    },
    "risk": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "summary": {
      "type": "string"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "order",
          "description",
          "paths"
        ],
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rollback": {
            "type": "string"
          }
        }
      }
    },
    "validation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "protectedPathChanges": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approvalRequired": {
      "type": "boolean"
    }
  }
}
