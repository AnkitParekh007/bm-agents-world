{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Frontend Pull Request Draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "sourceBranch",
    "targetBranch",
    "description",
    "checks"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "sourceBranch": {
      "type": "string",
      "minLength": 1
    },
    "targetBranch": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "issueKeys": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "testEvidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risk": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "rollback": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reviewers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "draft": {
      "type": "boolean"
    }
  }
}
