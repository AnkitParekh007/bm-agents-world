{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Frontend Story Context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runId",
    "project",
    "repository",
    "issueKey",
    "summary",
    "acceptanceCriteria",
    "frameworkProfile"
  ],
  "properties": {
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "issueKey": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "acceptanceCriteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "frameworkProfile": {
      "type": "string",
      "enum": [
        "angular-12-legacy",
        "angular-15",
        "angularjs-maintenance",
        "angular-modern",
        "unknown"
      ]
    },
    "affectedRoles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "uxStates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "designRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "apiRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
