{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Frontend Agent Approval Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "approvalId",
    "runId",
    "action",
    "target",
    "payloadHash",
    "expiresAt"
  ],
  "properties": {
    "approvalId": {
      "type": "string",
      "minLength": 1
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "project": {
      "type": "string"
    },
    "repository": {
      "type": "string"
    },
    "branch": {
      "type": "string"
    },
    "issueKey": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "risk": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "payloadHash": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "qualityReportRef": {
      "type": "string"
    },
    "rollback": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "idempotencyKey": {
      "type": "string"
    }
  }
}
