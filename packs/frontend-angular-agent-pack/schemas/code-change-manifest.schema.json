{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Frontend Code Change Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runId",
    "project",
    "repository",
    "baseCommit",
    "files",
    "patchSha256"
  ],
  "properties": {
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "baseCommit": {
      "type": "string",
      "minLength": 1
    },
    "workingBranch": {
      "type": "string"
    },
    "patchSha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "action",
          "summary"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "enum": [
              "add",
              "modify",
              "delete",
              "rename",
              "generated"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "protected": {
            "type": "boolean"
          }
        }
      }
    },
    "behaviorChanges": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "testsAddedOrChanged": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependenciesChanged": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rollback": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
