{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.internal/schemas/requirements-package.schema.json",
  "title": "Requirements Package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "businessNeed",
    "requirements",
    "traceability"
  ],
  "properties": {
    "businessNeed": {
      "type": "string",
      "minLength": 1
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "statement",
          "source",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "business",
              "stakeholder",
              "functional",
              "nonfunctional",
              "transition",
              "data",
              "integration"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "draft",
              "validated",
              "approved",
              "superseded",
              "retired"
            ]
          },
          "acceptanceCriteria": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "businessRules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "traceability": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
