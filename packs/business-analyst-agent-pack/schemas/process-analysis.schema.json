{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.internal/schemas/process-analysis.schema.json",
  "title": "Process Analysis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "processName",
    "currentState",
    "issues",
    "futureState"
  ],
  "properties": {
    "processName": {
      "type": "string",
      "minLength": 1
    },
    "trigger": {
      "type": "string",
      "minLength": 1
    },
    "actors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "currentState": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "futureState": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "measures": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
