{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.internal/schemas/approval-request.schema.json",
  "title": "Approval Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requestId",
    "action",
    "payloadHash",
    "approverRole",
    "expiresAt"
  ],
  "properties": {
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "type": "string",
      "minLength": 1
    },
    "payloadHash": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "approverRole": {
      "type": "string",
      "minLength": 1
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
