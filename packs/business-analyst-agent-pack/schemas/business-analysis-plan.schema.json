{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.internal/schemas/business-analysis-plan.schema.json",
  "title": "Business Analysis Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "objective",
    "approach",
    "deliverables",
    "stakeholders",
    "risks"
  ],
  "properties": {
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "approach": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stakeholders": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "elicitationPlan": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validationPlan": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decisionRequests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
