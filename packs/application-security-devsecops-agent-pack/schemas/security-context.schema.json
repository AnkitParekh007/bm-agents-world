{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Security Context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project",
    "assets",
    "source_revision",
    "environments",
    "data_classification",
    "owners"
  ],
  "properties": {
    "project": {
      "type": "string",
      "minLength": 1
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "environments": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "data_classification": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "owners": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "policies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
