{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Security Status Update",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scope",
    "timestamp",
    "summary",
    "status",
    "next_actions"
  ],
  "properties": {
    "scope": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "summary": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "confirmed_facts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decisions_required": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "audience": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
