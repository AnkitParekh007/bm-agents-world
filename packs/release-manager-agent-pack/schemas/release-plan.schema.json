{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Release Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "release_id",
    "scope",
    "milestones",
    "dependencies",
    "owners",
    "environments",
    "success_criteria"
  ],
  "properties": {
    "release_id": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "excluded_scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "owners": {
      "type": "object"
    },
    "environments": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "window": {
      "type": "object"
    },
    "success_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "communication_plan": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rollback_reference": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
