{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Release Readiness Assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "release_id",
    "candidate_hash",
    "domains",
    "blockers",
    "decision_options"
  ],
  "properties": {
    "release_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_hash": {
      "type": "string",
      "minLength": 1
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "status",
          "evidence"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "ready",
              "conditional",
              "blocked",
              "not-applicable",
              "unknown"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "gaps": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "decision_options": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "final_decision": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
