{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Release Status Update",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "release_id",
    "timestamp",
    "state",
    "audience",
    "facts",
    "next_checkpoint"
  ],
  "properties": {
    "release_id": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "type": "string",
      "enum": [
        "planned",
        "ready",
        "approved",
        "in-progress",
        "paused",
        "partially-released",
        "rolled-back",
        "validated",
        "closed",
        "cancelled"
      ]
    },
    "audience": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "completed_steps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "next_checkpoint": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    }
  }
}
