{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Database Work Context",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "jira_item": {
      "type": "string",
      "minLength": 1
    },
    "request_type": {
      "type": "string",
      "enum": [
        "architecture",
        "schema-change",
        "sql-development",
        "performance",
        "data-movement",
        "security",
        "recovery",
        "release"
      ]
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "database_scope": {
      "type": "object"
    },
    "data_classification": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "run_id",
    "project",
    "jira_item",
    "request_type",
    "requirements",
    "database_scope"
  ]
}
