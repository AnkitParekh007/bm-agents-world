{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Database Migration Plan",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "object"
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "forward_steps": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "compatibility_window": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "validation": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "recovery": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "expected_duration_seconds": {
      "type": "integer",
      "minimum": 0
    },
    "expected_rows": {
      "type": "integer",
      "minimum": 0
    },
    "lock_risk": {
      "type": "string",
      "enum": [
        "none",
        "low",
        "medium",
        "high",
        "unknown"
      ]
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "run_id",
    "target",
    "preconditions",
    "forward_steps",
    "validation",
    "recovery",
    "lock_risk"
  ]
}
