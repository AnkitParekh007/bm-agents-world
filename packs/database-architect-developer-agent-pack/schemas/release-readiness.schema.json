{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Database Release Readiness",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "release": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "go",
        "conditional-go",
        "no-go"
      ]
    },
    "target": {
      "type": "object"
    },
    "compatibility": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "backup_recovery": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "monitoring": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_hashes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "run_id",
    "release",
    "status",
    "target",
    "evidence_hashes"
  ]
}
