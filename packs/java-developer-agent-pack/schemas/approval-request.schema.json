{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/java-agent/approval-request.schema.json",
  "title": "Approval Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runId",
    "action",
    "payloadHash",
    "scope",
    "reason",
    "expiresAt"
  ],
  "properties": {
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "type": "string",
      "minLength": 1
    },
    "payloadHash": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "scope": {
      "type": "object"
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "riskSummary": {
      "type": "string",
      "minLength": 1
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
