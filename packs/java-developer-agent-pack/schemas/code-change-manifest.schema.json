{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/java-agent/code-change-manifest.schema.json",
  "title": "Code Change Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runId",
    "baseCommit",
    "files",
    "contracts",
    "tests"
  ],
  "properties": {
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "baseCommit": {
      "type": "string",
      "minLength": 1
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "changeType"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "changeType": {
            "enum": [
              "add",
              "modify",
              "delete",
              "rename"
            ]
          },
          "symbols": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    },
    "contracts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "migrations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
