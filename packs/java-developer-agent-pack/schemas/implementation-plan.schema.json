{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/java-agent/implementation-plan.schema.json",
  "title": "Implementation Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runId",
    "baseCommit",
    "repositoryProfile",
    "steps",
    "risks",
    "qualityGates"
  ],
  "properties": {
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "baseCommit": {
      "type": "string",
      "minLength": 1
    },
    "repositoryProfile": {
      "type": "object"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "agent"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "agent": {
            "type": "string",
            "minLength": 1
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "qualityGates": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "rollbackPlan": {
      "type": "string",
      "minLength": 1
    }
  }
}
