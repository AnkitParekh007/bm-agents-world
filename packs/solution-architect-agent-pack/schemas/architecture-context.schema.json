{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bm-agent-foundry.local/schemas/architecture-context.schema.json",
  "title": "Architecture Context",
  "type": "object",
  "required": [
    "contextId",
    "projectIds",
    "problemStatement",
    "scope",
    "stakeholders",
    "systems",
    "constraints",
    "assumptions",
    "evidence"
  ],
  "properties": {
    "contextId": {
      "type": "string",
      "minLength": 1
    },
    "projectIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "problemStatement": {
      "type": "string",
      "minLength": 1
    },
    "businessOutcomes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scope": {
      "type": "object",
      "required": [
        "in",
        "out"
      ],
      "properties": {
        "in": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "out": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "stakeholders": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "role",
          "decisionRights"
        ],
        "properties": {
          "role": {
            "type": "string"
          },
          "decisionRights": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "contactReference": {
            "type": "string"
          }
        }
      }
    },
    "systems": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "owner",
          "criticality"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "criticality": {
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "repositoryReferences": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "statement",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "statement": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "hard": {
            "type": "boolean"
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "statement",
          "validationStatus"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "statement": {
            "type": "string"
          },
          "validationStatus": {
            "enum": [
              "unvalidated",
              "validated",
              "invalidated"
            ]
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "dataClassification": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ]
    },
    "environments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "source",
          "retrievedAt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "retrievedAt": {
            "type": "string",
            "format": "date-time"
          },
          "hash": {
            "type": "string"
          }
        }
      }
    }
  },
  "additionalProperties": false
}
