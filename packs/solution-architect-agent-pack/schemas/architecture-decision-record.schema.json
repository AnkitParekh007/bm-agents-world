{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bm-agent-foundry.local/schemas/architecture-decision-record.schema.json",
  "title": "Architecture Decision Record",
  "type": "object",
  "required": [
    "adrId",
    "title",
    "status",
    "context",
    "decision",
    "consequences",
    "optionsConsidered",
    "owners",
    "createdAt",
    "evidenceRefs"
  ],
  "properties": {
    "adrId": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "enum": [
        "proposed",
        "accepted",
        "rejected",
        "deprecated",
        "superseded"
      ]
    },
    "context": {
      "type": "string"
    },
    "decision": {
      "type": "string"
    },
    "decisionScope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "optionsConsidered": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      }
    },
    "consequences": {
      "type": "object",
      "required": [
        "positive",
        "negative",
        "risks"
      ],
      "properties": {
        "positive": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "negative": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "qualityAttributes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "owners": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approvalReference": {
      "type": "string"
    },
    "payloadHash": {
      "type": "string"
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
