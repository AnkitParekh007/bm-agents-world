{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Incident Command",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "incident_id",
    "severity",
    "commander",
    "affected_scope",
    "objectives",
    "timeline"
  ],
  "properties": {
    "incident_id": {
      "type": "string",
      "minLength": 1
    },
    "severity": {
      "type": "string",
      "minLength": 1
    },
    "commander": {
      "type": "string",
      "minLength": 1
    },
    "affected_scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "roles": {
      "type": "object"
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
