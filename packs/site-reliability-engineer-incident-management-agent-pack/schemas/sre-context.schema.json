{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SRE Context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project",
    "service",
    "environment",
    "authorized",
    "sources"
  ],
  "properties": {
    "project": {
      "type": "string",
      "minLength": 1
    },
    "service": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "string",
      "minLength": 1
    },
    "authorized": {
      "const": true
    },
    "service_tier": {
      "type": "string"
    },
    "owners": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "raw_secrets_present": {
      "const": false
    }
  }
}
