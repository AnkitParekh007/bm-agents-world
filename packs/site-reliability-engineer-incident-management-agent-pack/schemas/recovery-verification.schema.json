{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Recovery Verification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "incident_id",
    "criteria",
    "observations",
    "observation_window",
    "state"
  ],
  "properties": {
    "incident_id": {
      "type": "string",
      "minLength": 1
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "observation_window": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": [
        "not_recovered",
        "partially_recovered",
        "recovered_monitoring",
        "sustained_recovery"
      ]
    },
    "remaining_risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
