{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Post-Incident Review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "incident_id",
    "impact",
    "timeline",
    "contributing_factors",
    "learning",
    "actions",
    "blameless"
  ],
  "properties": {
    "incident_id": {
      "type": "string",
      "minLength": 1
    },
    "impact": {
      "type": "object"
    },
    "timeline": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "trigger": {
      "type": "string"
    },
    "contributing_factors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "learning": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "blameless": {
      "const": true
    },
    "unsupported_certainty": {
      "const": false
    }
  }
}
