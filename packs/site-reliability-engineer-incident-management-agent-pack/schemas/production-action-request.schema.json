{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Production Action Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action",
    "target",
    "reason",
    "payload_hash",
    "risk",
    "rollback",
    "verification",
    "approval"
  ],
  "properties": {
    "action": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "object"
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "payload_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "risk": {
      "type": "object"
    },
    "stop_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rollback": {
      "type": "object"
    },
    "verification": {
      "type": "object"
    },
    "approval": {
      "type": "object"
    },
    "free_form_agent_executes": {
      "const": false
    }
  }
}
