{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/product-manager/prioritization-decision.schema.json",
  "title": "Prioritization Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidates",
    "model",
    "recommendation",
    "tradeoffs",
    "confidence"
  ],
  "properties": {
    "candidates": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "model": {
      "type": "object"
    },
    "recommendation": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tradeoffs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sensitivity_analysis": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
