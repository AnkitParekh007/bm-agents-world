{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/integration-handoff.schema.json",
  "title": "Integration Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "architecture_ref",
    "contracts",
    "owners",
    "implementation_slices",
    "validation_gates"
  ],
  "properties": {
    "architecture_ref": {
      "type": "string"
    },
    "contracts": {
      "type": "array"
    },
    "owners": {
      "type": "array"
    },
    "implementation_slices": {
      "type": "array"
    },
    "validation_gates": {
      "type": "array"
    },
    "rollout": {
      "type": "object"
    },
    "observability": {
      "type": "object"
    }
  }
}
