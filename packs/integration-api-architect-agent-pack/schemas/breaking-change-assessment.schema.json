{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/breaking-change-assessment.schema.json",
  "title": "Breaking Change Assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "interface",
    "change",
    "affected_consumers",
    "migration",
    "risk"
  ],
  "properties": {
    "interface": {
      "type": "string"
    },
    "change": {
      "type": "object"
    },
    "affected_consumers": {
      "type": "array"
    },
    "migration": {
      "type": "object"
    },
    "deprecation": {
      "type": "object"
    },
    "risk": {
      "type": "object"
    }
  }
}
