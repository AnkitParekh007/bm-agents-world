{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "Python Quality Gate Report",
  "required": [
    "runId",
    "overall",
    "gates"
  ],
  "properties": {
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "overall": {
      "enum": [
        "passed",
        "failed",
        "blocked",
        "warning"
      ]
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "blocked",
              "skipped",
              "warning"
            ]
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "artifactRef": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "coverage": {
      "type": "object"
    },
    "openFindings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
