{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/customer-success/escalation-plan.schema.json",
  "title": "Customer Escalation Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "customer_id",
    "issue",
    "impact",
    "owner",
    "actions"
  ],
  "properties": {
    "customer_id": {
      "type": "string"
    },
    "issue": {
      "type": "string"
    },
    "impact": {
      "type": "string"
    },
    "severity": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "communication_plan": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stop_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review_date": {
      "type": "string"
    }
  }
}
