{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bm-agent-foundry.local/schemas/backlog-item.schema.json",
  "title": "Backlog Item",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "purpose",
    "value",
    "acceptance_criteria",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string"
    },
    "value": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "idea",
        "discovery",
        "refinement",
        "ready",
        "selected",
        "in-progress",
        "validation",
        "done",
        "archived"
      ]
    }
  }
}
