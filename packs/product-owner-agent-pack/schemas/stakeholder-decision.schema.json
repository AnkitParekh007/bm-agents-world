{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bm-agent-foundry.local/schemas/stakeholder-decision.schema.json",
  "title": "Stakeholder Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision_id",
    "question",
    "options",
    "decision_owner",
    "status"
  ],
  "properties": {
    "decision_id": {
      "type": "string"
    },
    "question": {
      "type": "string"
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decision_owner": {
      "type": "string"
    },
    "status": {
      "enum": [
        "draft",
        "pending",
        "approved",
        "rejected",
        "superseded"
      ]
    },
    "decision": {
      "type": [
        "string",
        "null"
      ]
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
