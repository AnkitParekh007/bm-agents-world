{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bm-agent-foundry.local/schemas/sprint-readiness.schema.json",
  "title": "Sprint Readiness",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sprint",
    "goal_options",
    "candidate_items",
    "readiness",
    "open_decisions"
  ],
  "properties": {
    "sprint": {
      "type": "string"
    },
    "goal_options": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "candidate_items": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "open_decisions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommendation": {
      "type": "string"
    }
  }
}
