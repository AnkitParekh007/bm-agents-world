{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bm-agent-foundry.local/schemas/release-acceptance.schema.json",
  "title": "Release Acceptance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "release_id",
    "scope",
    "evidence",
    "known_risks",
    "recommendation",
    "decision_owner"
  ],
  "properties": {
    "release_id": {
      "type": "string"
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "known_risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rollout_plan": {
      "type": "string"
    },
    "rollback_plan": {
      "type": "string"
    },
    "recommendation": {
      "enum": [
        "go",
        "conditional-go",
        "no-go",
        "defer"
      ]
    },
    "decision_owner": {
      "type": "string"
    },
    "human_decision": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
