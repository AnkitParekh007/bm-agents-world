{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/devops-agent/pipeline-change.schema.json",
  "title": "Pipeline Change",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "engine",
    "repository",
    "source_revision",
    "stages",
    "artifacts",
    "gates",
    "pipeline_hash"
  ],
  "properties": {
    "engine": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "source_revision": {
      "type": "string",
      "minLength": 1
    },
    "triggers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "runners": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "credentials": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "side_effects": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rollback": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "pipeline_hash": {
      "type": "string",
      "minLength": 1
    }
  }
}
