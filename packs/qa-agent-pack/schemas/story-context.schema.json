{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Story Context Brief",
  "type": "object",
  "required": [
    "artifactId",
    "project",
    "jiraIssueKey",
    "objective",
    "acceptanceCriteria",
    "risks",
    "sources"
  ],
  "properties": {
    "artifactId": {
      "type": "string"
    },
    "project": {
      "type": "string"
    },
    "jiraIssueKey": {
      "type": "string"
    },
    "objective": {
      "type": "string"
    },
    "acceptanceCriteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "description",
          "rating"
        ],
        "properties": {
          "description": {
            "type": "string"
          },
          "rating": {
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
